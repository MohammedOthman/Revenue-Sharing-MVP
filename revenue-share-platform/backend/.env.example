# Copy this file to .env and fill in real values.

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=revenue_share
# Owner/superuser role. Migrations, seed, and any unscoped bootstrap query run as
# this role (it bypasses row-level security).
DB_USER=postgres
DB_PASSWORD=postgres
# Application role. The API serves each request as this non-superuser role
# (created by migration 004) so tenant row-level security applies. Defaults to
# reven_app; set a password in any real environment.
DB_APP_USER=reven_app
DB_APP_PASSWORD=

# Auth — use a long random string in any real environment
JWT_SECRET=change-me-to-a-long-random-secret

# CORS — comma-separated allowed origins, enforced only when NODE_ENV=production.
# Leave empty for local development (the Vite dev server proxies same-origin).
CORS_ORIGINS=
