# Copy this file to .env and fill in real values.

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=revenue_share
DB_USER=postgres
DB_PASSWORD=postgres

# Auth — use a long random string in any real environment
JWT_SECRET=change-me-to-a-long-random-secret

# CORS — comma-separated allowed origins, enforced only when NODE_ENV=production.
# Leave empty for local development (the Vite dev server proxies same-origin).
CORS_ORIGINS=
