# Copy this file to .env and fill in real values.

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=revenue_share
# Migrations/seed run as an owner/superuser. Once tenant enforcement is wired,
# run the API as the non-superuser role created by migration 004 (reven_app)
# so row-level security applies.
DB_USER=postgres
DB_PASSWORD=postgres

# Auth — use a long random string in any real environment
JWT_SECRET=change-me-to-a-long-random-secret

# CORS — comma-separated allowed origins, enforced only when NODE_ENV=production.
# Leave empty for local development (the Vite dev server proxies same-origin).
CORS_ORIGINS=
