# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database (option A: single URL — Render/Railway/Neon/Supabase/Replit) ---
# DATABASE_URL=postgres://user:password@host:5432/revenue_share
# DB_SSL=true

# --- Database (option B: discrete settings for local Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=revenue_share
DB_USER=postgres
DB_PASSWORD=postgres

# --- Auth (REQUIRED in production; generate with: openssl rand -hex 32) ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- CORS: comma-separated origins allowed to call the API from a browser.
# Leave empty when the API serves the frontend itself (same origin).
CORS_ORIGINS=

# --- Registration policy ---
# First registered user always becomes admin (bootstrap). After that,
# self-signup is disabled unless this is true; admins can always create users.
ALLOW_OPEN_REGISTRATION=false

# --- Seed script (npm run seed / seed:demo) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Platform Admin

# --- Tuning (optional) ---
# BCRYPT_ROUNDS=10
# DB_POOL_MAX=20
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=1000
# AUTH_RATE_LIMIT_MAX=20
# LOG_REQUESTS=true
