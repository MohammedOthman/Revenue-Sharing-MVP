# Copy this file to .env and fill in real values. The server refuses to start
# if JWT_SECRET or a database configuration is missing.

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Auth ----
# Generate a long random string, e.g.:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string

# ---- Database ----
# Option A: managed Postgres (Neon / Supabase / Render / Railway) gives you one
# connection string. Uncomment these two and leave the DB_* block blank.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DB_SSL=true

# Option B: local Postgres for development.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=revenue_share
DB_USER=postgres
DB_PASSWORD=postgres

# ---- CORS (production) ----
# Comma-separated list of allowed frontend origins. Leave unset to allow all
# origins (acceptable for local dev only; set it before going live).
# CORS_ORIGIN=https://app.example.com
